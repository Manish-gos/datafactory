			"type": "string",
			"defaultValue": "https://randomuser.me"
		},
		"json_sink_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dataengineering101398.dfs.core.windows.net/"
		},
		"SqlServeronprem_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"SqlServeronprem_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorksDW2022"
		},
		"SqlServeronprem_properties_typeProperties_userName": {
			"type": "string",
